{
  "name": "sst-saas-platform",
  "version": "1.1.0-checkpoint.9.11",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --tsconfig ./tsconfig.json ./src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate:source && npm run validate:schema && npm test",
    "postinstall": "prisma generate",
    "db:deploy": "prisma db push --skip-generate",
    "preflight": "node scripts/preflight.mjs",
    "validate:source": "node scripts/validate-source.mjs",
    "validate:schema": "node scripts/validate-prisma-schema.mjs",
    "preflight:seed": "node scripts/preflight-seed.mjs",
    "verify": "npm run validate:source && npm run validate:schema && npm run preflight && npx prisma format && npx prisma format --check && npx prisma validate && npx prisma generate && npm run typecheck && npm test && npm run build",
    "generate:offline-types": "node scripts/generate-offline-prisma-types.mjs",
    "typecheck:offline": "npm run generate:offline-types && tsc -p tsconfig.offline.json",
    "verify:offline": "npm run validate:source && npm run validate:schema && npm run typecheck:offline && npm run preflight && npm run preflight:seed && npm test",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.888.0",
    "@aws-sdk/s3-request-presigner": "3.888.0",
    "@prisma/client": "6.16.2",
    "archiver": "7.0.1",
    "argon2": "0.44.0",
    "clsx": "2.1.1",
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "jose": "6.1.0",
    "next": "15.5.20",
    "playwright-core": "1.55.0",
    "qrcode": "1.5.4",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "tailwind-merge": "3.3.1",
    "tsx": "4.20.5",
    "unzipper": "0.12.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "type": "module"
}
