{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "noResolve": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "allowSyntheticDefaultImports": true
  },
  "include": ["types/syntax-shims.d.ts", "src/**/*.ts", "src/**/*.tsx", "prisma/**/*.ts", "tests/**/*.ts"]
}
