# Aplicação
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sst_saas?schema=public
APP_URL=http://localhost:3000
AUTH_SECRET=change-this-to-at-least-32-random-characters
SESSION_TTL_DAYS=14
NEXT_PUBLIC_APP_NAME=Plataforma SST

# Arquivos: use local em desenvolvimento e s3 na Railway
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Exatamente 64 caracteres hexadecimais
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Worker e relatórios
WORKER_POLL_MS=2500
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
RUN_DB_SCHEMA_SYNC=true

# Integrações opcionais
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Seed inicial: defina antes de executar npm run db:seed
SEED_TENANT_NAME=Minha Consultoria SST
SEED_TENANT_SLUG=minha-consultoria-sst
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte
SEED_DEMO_DATA=false
